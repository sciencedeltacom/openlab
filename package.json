    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "^5.5.0",
    "ai": "^7",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "katex": "^0.19.0",
    "lucide-react": "^0.540.0",
    "mermaid": "^12.2.0",
    "motion": "^12.43.0",
    "ora": "^9.4.1",
    "pdfjs-dist": "^6.4.299",
    "picocolors": "^1.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-xtermjs": "^1.0.12",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.7.0",
    "thinking-orbs": "^0.3.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "bun-types": "^1.4.3",
    "drizzle-kit": "^0.31.11",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.2",
    "vite": "^7.0.0"
  },
  "packageManager": "bun@1.3.14",
  "overrides": {
