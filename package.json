    "@internationalized/date": "^3.12.4",
    "@lezer/highlight": "^1.2.5",
    "@nivo/bar": "^0.99.0",
    "@nivo/core": "^0.99.0",
    "@nivo/line": "^0.99.0",
    "@nivo/pie": "^0.99.0",
    "@oclif/core": "^5.1.8",
    "@oclif/plugin-autocomplete": "^4.0.5",
    "@openuidev/react-lang": "^0.3.2",
    "@openuidev/react-ui": "^0.17.0",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
