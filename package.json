{
  "name": "openlab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "openlab \u2014 the research workbench by ScienceDelta",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "cli": "bun cli/bin/run.js",
    "cli:typecheck": "tsc -p cli/tsconfig.json --noEmit",
    "verify:cli": "bun scripts/verify-cli.ts",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "verify": "bun run verify:web && bun run test",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"cli/src/**/*.ts\" \"cli/*.{json,md}\" \"*.{ts,json}\"",
    "icons": "tauri icon app-icon.png",
    "db:generate": "drizzle-kit generate",
    "verify:science": "bun scripts/verify-science.ts && bun scripts/verify-science-connectors.ts",
    "verify:statistics": "bun scripts/verify-statistics.ts",
    "verify:chat": "bun scripts/verify-chat.ts",
    "verify:routes": "bun scripts/verify-routes.ts",
    "verify:packs": "bun scripts/verify-packs.ts",
    "verify:extensions": "bun scripts/verify-extensions.ts",
    "verify:context": "bun scripts/verify-context.ts",
    "verify:agent": "bun scripts/verify-agent.ts",
    "verify:tracker": "bun scripts/verify-tracker.ts",
    "verify:mirror": "bun scripts/verify-mirror.ts",
    "verify:plan": "bun scripts/verify-plan.ts",
    "verify:figures": "bun scripts/verify-figures.ts",
    "verify:literature": "bun scripts/verify-literature.ts",
    "verify:agents": "bun scripts/verify-agents.ts",
    "verify:autoresearch": "bun scripts/verify-autoresearch.ts",
    "verify:compute": "bun scripts/verify-compute.ts",
    "verify:scan": "bun scripts/verify-scan.ts",
    "verify:storage": "bun scripts/verify-storage.ts",
    "verify:container": "bun scripts/verify-container.ts",
    "bench": "bun scripts/benchmark.ts",
    "bench:compare": "bun scripts/benchmark.ts compare",
    "bench:pages": "bun scripts/bench-pages.ts",
    "verify:files": "bun scripts/verify-files.ts",
    "verify:sync": "bun scripts/verify-sync.ts",
    "verify:settings": "bun scripts/verify-settings.ts",
    "verify:permissions": "bun scripts/verify-permissions.ts",
    "resources:build": "bun scripts/build-resources.ts",
    "verify:web": "bun run typecheck && bun run cli:typecheck && bun run verify:container && bun run verify:science && bun run verify:statistics && bun run verify:routes && bun run verify:settings && bun run verify:permissions && bun run verify:chat && bun run verify:packs && bun run verify:extensions && bun run verify:context && bun run verify:preregistration && bun run verify:session-plan && bun run verify:mcp && bun run verify:agent && bun run verify:tracker && bun run verify:mirror && bun run verify:plan && bun run verify:figures && bun run verify:literature && bun run verify:agents && bun run verify:autoresearch && bun run verify:compute && bun run verify:files && bun run verify:sync && bun run verify:notebook && bun run verify:scan && bun run verify:storage && bun run verify:cli",
    "verify:preregistration": "bun scripts/verify-preregistration.ts",
    "verify:session-plan": "bun scripts/verify-session-plan.ts",
    "verify:mcp": "bun scripts/verify-mcp.ts",
    "verify:e2e": "playwright test",
    "verify:e2e:install": "playwright install chromium",
    "verify:notebook": "bun scripts/verify-notebook.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4",
    "@ai-sdk/google": "^4",
    "@ai-sdk/openai-compatible": "^3",
